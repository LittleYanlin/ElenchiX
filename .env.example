# Copy to .env. Never commit real credentials.
ELENCHIX_LLM_API_KEY=
ELENCHIX_LLM_BASE_URL=https://api.openai.com/v1

# Optional role-specific endpoints. The YAML decides which names are read.
ELENCHIX_PLANNING_API_KEY=
ELENCHIX_PLANNING_BASE_URL=
ELENCHIX_TEACHING_API_KEY=
ELENCHIX_TEACHING_BASE_URL=
ELENCHIX_ASSESSMENT_API_KEY=
ELENCHIX_ASSESSMENT_BASE_URL=
